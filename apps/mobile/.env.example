# PulmoCare Flutter configuration reference
#
# The mobile app does not automatically load .env files.
# API_BASE_URL is a compile-time Dart define:
#
# Android emulator:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:9080/api/
#
# Web/desktop:
#   flutter run --dart-define=API_BASE_URL=http://localhost:9080/api/
#
# Release:
#   flutter build appbundle \
#     --dart-define=API_BASE_URL=https://api.example.com/api/
#
# Release builds require HTTPS.
#
# Android Google Maps configuration belongs in the gitignored
# android/local.properties file:
#   MAPS_API_KEY=your_android_restricted_maps_key
#
# AI provider credentials are backend-only and must not be placed in Flutter.
