{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "pulmocare"
    },
    "apps/api/services/auth/app": {
      "release-type": "python",
      "component": "auth-service"
    },
    "apps/api/services/patients/app": {
      "release-type": "python",
      "component": "patients-service"
    },
    "apps/mobile": {
      "release-type": "dart",
      "component": "mobile"
    }
  }
}
